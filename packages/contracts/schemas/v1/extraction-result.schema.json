{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Structured extraction result v1 (draft)",
  "description": "Rules and model output: evidence locations, name associations and observations only. Candidate IDs, QC issues and severities are assigned server-side after this result is validated.",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "file_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "array",
            "description": "Every name associated with this record. Empty when none was found; more than one when sources conflict.",
            "items": {
              "$ref": "common.schema.json#/$defs/name"
            }
          },
          "molecule_type": {
            "$ref": "common.schema.json#/$defs/molecule_type",
            "description": "A hint only. Deterministic QC11 decides classification."
          },
          "sequence_spans": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/sequence_span"
            }
          },
          "association_status": {
            "type": "string",
            "enum": [
              "unambiguous",
              "ambiguous",
              "conflicting"
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/observation"
            }
          }
        },
        "required": [
          "names",
          "molecule_type",
          "sequence_spans",
          "association_status",
          "observations"
        ]
      }
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "run_id",
    "records",
    "coverage"
  ]
}
