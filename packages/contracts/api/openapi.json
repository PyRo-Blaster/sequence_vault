{
  "components": {
    "schemas": {
      "CandidatePatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sequence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SequenceEdit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "CandidatePatch",
        "type": "object"
      },
      "CommitItemModel": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "candidate_id",
          "revision"
        ],
        "title": "CommitItemModel",
        "type": "object"
      },
      "CommitRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CommitItemModel"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CommitRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResolutionRequest": {
        "properties": {
          "resolution": {
            "title": "Resolution",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "revision",
          "rule_id",
          "resolution"
        ],
        "title": "ResolutionRequest",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "candidate_id": {
            "title": "Candidate Id",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "candidate_id",
          "revision",
          "decision"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "RevisionRequest": {
        "properties": {
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "title": "RevisionRequest",
        "type": "object"
      },
      "SequenceEdit": {
        "properties": {
          "fragment": {
            "default": false,
            "title": "Fragment",
            "type": "boolean"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "spans": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SpanModel"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spans"
          },
          "typed_sequence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Typed Sequence"
          }
        },
        "required": [
          "reason"
        ],
        "title": "SequenceEdit",
        "type": "object"
      },
      "SpanModel": {
        "properties": {
          "block_id": {
            "title": "Block Id",
            "type": "string"
          },
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "order": {
            "minimum": 1.0,
            "title": "Order",
            "type": "integer"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          }
        },
        "required": [
          "block_id",
          "start",
          "end",
          "order"
        ],
        "title": "SpanModel",
        "type": "object"
      },
      "UploadRequest": {
        "properties": {
          "byte_count": {
            "minimum": 0.0,
            "title": "Byte Count",
            "type": "integer"
          },
          "file_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "File Name",
            "type": "string"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "file_name",
          "byte_count",
          "sha256"
        ],
        "title": "UploadRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
