{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "DocumentIR v1 (draft)",
  "description": "Immutable source-bound blocks; offsets use Unicode code points and half-open ranges.",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "file_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "source_encoding": {
      "type": "string",
      "minLength": 1,
      "description": "Decoding applied to source bytes, for example utf-8 or utf-8-sig. raw_text is never Unicode-normalized, so offsets stay valid against the decoded source."
    },
    "parse_options": {
      "type": "object",
      "additionalProperties": false,
      "description": "User choices that change block content. A different choice is a different parse and a new run.",
      "properties": {
        "tracked_changes_view": {
          "type": "string",
          "enum": [
            "not_applicable",
            "original",
            "changes_accepted"
          ]
        }
      },
      "required": [
        "tracked_changes_view"
      ]
    },
    "offset_unit": {
      "const": "unicode_codepoint"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "paragraph",
              "table_cell",
              "fasta_header",
              "sequence",
              "text",
              "image"
            ]
          },
          "raw_text": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "docx_paragraph",
                  "docx_table_cell",
                  "spreadsheet_cell",
                  "pdf_region",
                  "image_region"
                ]
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "paragraph_index": {
                "type": "integer",
                "minimum": 0
              },
              "table_index": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "worksheet": {
                "type": "string",
                "minLength": 1
              },
              "cell": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "kind"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "text"
                    }
                  }
                },
                "then": {
                  "required": [
                    "line_start",
                    "line_end"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "docx_paragraph"
                    }
                  }
                },
                "then": {
                  "required": [
                    "paragraph_index"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "docx_table_cell"
                    }
                  }
                },
                "then": {
                  "required": [
                    "table_index",
                    "row",
                    "column"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "spreadsheet_cell"
                    }
                  }
                },
                "then": {
                  "required": [
                    "worksheet",
                    "cell"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "pdf_region"
                    }
                  }
                },
                "then": {
                  "required": [
                    "page",
                    "bbox"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "image_region"
                    }
                  }
                },
                "then": {
                  "required": [
                    "bbox"
                  ]
                }
              }
            ]
          },
          "extraction_method": {
            "type": "string",
            "enum": [
              "text_parser",
              "ocr",
              "manual_transcription"
            ]
          }
        },
        "required": [
          "block_id",
          "type",
          "raw_text",
          "location",
          "extraction_method"
        ]
      }
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    }
  },
  "required": [
    "schema_version",
    "file_id",
    "run_id",
    "source_sha256",
    "parser_version",
    "source_encoding",
    "parse_options",
    "offset_unit",
    "blocks",
    "coverage"
  ]
}
