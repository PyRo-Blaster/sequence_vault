# Copy to compose.env (ignored by git) and fill in. Never commit real values.
# Any characters work; single-quote a value that contains "$" or "#" (Compose expands "$").
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEQUENCE_VAULT_PROXY_SECRET=
# OIDC client registered with the identity provider (redirect http://localhost:4180/oauth2/callback)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_EMAIL_DOMAINS=*
# Exactly 16, 24 or 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(24))"
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_COOKIE_SECURE=false
