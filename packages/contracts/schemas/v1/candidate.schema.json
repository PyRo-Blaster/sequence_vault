{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Review-facing candidate v1 (draft)",
  "description": "A draft review representation, not authority to commit. Raw source and deterministic transformations are preserved.",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Assigned by the server, never by the model."
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_record_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based index into the run's extraction result records; absent for candidates created by review splits or legacy import."
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "description": "The current name. Null until a name is selected or entered.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/name"
        },
        {
          "type": "null"
        }
      ]
    },
    "extracted_names": {
      "type": "array",
      "description": "Every name the run associated with this record, retained unchanged when the current name is edited.",
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      }
    },
    "sequence_spans": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sequence_span"
      }
    },
    "raw_text": {
      "type": "string"
    },
    "normalized_sequence": {
      "type": "string"
    },
    "molecule_type": {
      "$ref": "common.schema.json#/$defs/molecule_type"
    },
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "fragment",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "description": "SUPERSEDED marks candidates of an older extraction run; ARCHIVED is an explicit terminal decision that lets a task complete.",
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "BLOCKED",
        "APPROVED",
        "COMMITTED",
        "REJECTED",
        "PENDING_CONTENT",
        "ARCHIVED",
        "SUPERSEDED"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "extracted",
        "manual_revision",
        "legacy_import"
      ]
    },
    "transformation_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "positions": {
            "type": "array",
            "description": "Zero-based code-point positions in raw_text.",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "rule_id",
          "operation",
          "reason",
          "positions"
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/issue"
      }
    },
    "qc_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "run_id",
    "revision",
    "name",
    "extracted_names",
    "sequence_spans",
    "raw_text",
    "normalized_sequence",
    "molecule_type",
    "completeness",
    "status",
    "origin",
    "transformation_log",
    "issues",
    "qc_version"
  ]
}
