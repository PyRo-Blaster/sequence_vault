# Runtime configuration names (see services/backend/src/sequence_vault/settings.py). No live credentials.
SEQUENCE_VAULT_ENV=development
SEQUENCE_VAULT_DATABASE_URL=
SEQUENCE_VAULT_OBJECT_STORAGE_ENDPOINT=
SEQUENCE_VAULT_OBJECT_STORAGE_BUCKET=
SEQUENCE_VAULT_OBJECT_STORAGE_ACCESS_KEY=
SEQUENCE_VAULT_OBJECT_STORAGE_SECRET_KEY=

# Identity comes from the OIDC proxy (ADR 0006).
SEQUENCE_VAULT_IDENTITY_HEADER=X-Forwarded-Email
SEQUENCE_VAULT_PROXY_SECRET=
SEQUENCE_VAULT_STORAGE=s3
SEQUENCE_VAULT_SCANNER=clamd
SEQUENCE_VAULT_CLAMD_ADDRESS=
# AI is disabled until the organization approves its endpoint and data policy.
SEQUENCE_VAULT_AI_ENABLED=false
# anthropic (Claude API), bedrock (Amazon Bedrock) or vertex (Google Vertex AI)
SEQUENCE_VAULT_AI_PROVIDER=anthropic
SEQUENCE_VAULT_AI_MODEL_VERSION=claude-opus-5-5
SEQUENCE_VAULT_AI_EFFORT=medium
SEQUENCE_VAULT_AI_ENDPOINT=
SEQUENCE_VAULT_AI_API_KEY=
SEQUENCE_VAULT_AI_REGION=
SEQUENCE_VAULT_AI_PROJECT=
